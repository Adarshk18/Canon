# Canon environment variables
# Copy to .env only if you need overrides. Never commit .env.

# Optional debug logging (never logs secrets, PR bodies, or decision text)
# CANON_DEBUG=0

# Optional: override the project Canon directory (default: <repo>/.canon)
# CANON_HOME=

# Optional: override the SQLite path
# CANON_DB_PATH=

# Optional: override project config path
# CANON_CONFIG=

# Optional GitHub token. Prefer `gh auth login` instead of a long-lived token.
# Required only if you want PR mining and the GitHub CLI is not authenticated.
# Needs read-only access to repository metadata (public_repo or repo:read).
# GITHUB_TOKEN=

# Optional: disable color even on a TTY
# CANON_NO_COLOR=0

# Injection budget overrides (optional; project config is preferred)
# CANON_MAX_DECISIONS=12
# CANON_MAX_CHARS=4000
# CANON_MAX_TOKENS=1000

# Telemetry is OFF unless set to 1. Even then, V1 only writes local events
# to .canon/telemetry.jsonl. Nothing is sent over the network.
# CANON_TELEMETRY=0
